 */
router.get('/:id', protect, orderController.getOrderById);

/**
 * @openapi
 * /orders/{id}/resend-confirmation:
 *   post:
 *     summary: Resend the order confirmation email (owner or admin)
 *     tags: [Orders]
 *     security:
 *       - cookieAuth: []
 *       - bearerAuth: []
 *     parameters:
 *       - in: path
 *         name: id
 *         required: true
 *         schema:
 *           type: string
 *     responses:
 *       200:
 *         description: Confirmation email sent
 *         content:
 *           application/json:
 *             schema:
 *               type: object
 *               properties:
 *                 success:
 *                   type: boolean
 *                   example: true
 *                 message:
 *                   type: string
 *       401:
 *         $ref: '#/components/responses/Unauthorized'
 *       403:
 *         $ref: '#/components/responses/Forbidden'
 *       404:
 *         $ref: '#/components/responses/NotFound'
 *       429:
 *         description: Throttled — a confirmation was sent very recently
 *         content:
 *           application/json:
 *             schema:
 *               $ref: '#/components/schemas/Error'
 */
router.post('/:id/resend-confirmation', protect, orderController.resendConfirmation);

export default router;
</file>

