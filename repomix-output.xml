            CONSTRAINT DF_User_CreatedAt DEFAULT SYSUTCDATETIME(),
        UpdatedAt DATETIME2(3) NOT NULL
            CONSTRAINT DF_User_UpdatedAt DEFAULT SYSUTCDATETIME(),
