# Copy to .env and fill in real values. NEVER commit a populated .env.

# ── Runtime ───────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development
# error | warn | info | debug — defaults to debug in development, warn otherwise
LOG_LEVEL=
FRONTEND_URL=

# ── PostgreSQL (required) ─────────────────────────────────────────────────
# The application refuses to start without POSTGRES_URL.
POSTGRES_URL=postgresql://user:password@host:5432/kvs_ecommerce
POSTGRES_POOL_MAX=10
POSTGRES_IDLE_TIMEOUT_MS=30000
POSTGRES_CONNECTION_TIMEOUT_MS=10000
POSTGRES_STATEMENT_TIMEOUT_MS=30000
POSTGRES_SSL=false

# ── Migration tooling only — no runtime code reads these ───────────────────
# Needed by `npm run migration:*`. Safe to omit in production.
MONGO_URI=
POSTGRES_MIGRATION_URL=

# ── Auth ──────────────────────────────────────────────────────────────────
JWT_SECRET=
JWT_EXPIRE=30d
AUTH_COOKIE_NAME=token
# Cross-site cookies need COOKIE_SAMESITE=none + COOKIE_SECURE=true (HTTPS).
COOKIE_SECURE=
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=
COOKIE_MAX_AGE_DAYS=30

# ── CORS ──────────────────────────────────────────────────────────────────
# In production use a comma-separated allowlist, not `*`.
CORS_ORIGINS=*
CORS_CREDENTIALS=false
CORS_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Content-Type,Authorization,X-Requested-With

# ── Product images ────────────────────────────────────────────────────────
# Written to IMAGE_STORAGE_ROOT, served by Nginx under IMAGE_PUBLIC_BASE.
IMAGE_STORAGE_ROOT=/opt/kvs/storage/products
IMAGE_PUBLIC_BASE=/images/products

# ── Payments ──────────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ── Email (Brevo SMTP via Nodemailer) ─────────────────────────────────────
BREVO_SMTP_USER=
BREVO_SMTP_PASSWORD=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=KV Silver Zone

# ── WhatsApp (Meta Cloud API) — best-effort, safe to leave blank ──────────
WHATSAPP_PROVIDER=meta
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_API_VERSION=v21.0
# Set true once the Meta Authentication template is approved — gates login OTP,
# phone verification, and scheme-enrollment confirmation OTP over WhatsApp.
WHATSAPP_OTP_ENABLED=false
WHATSAPP_OTP_TEMPLATE=kv_otp
WHATSAPP_OTP_TEMPLATE_LANGUAGE=en_US
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
RATE_ALERT_RECIPIENT=

# ── Daily rate guard / OTP / returns ──────────────────────────────────────
RATE_UPDATE_CUTOFF_HOUR=10
OTP_EXPIRY_MINUTES=5
RETURN_VIDEO_WHATSAPP_NUMBER=
RETURN_CLAIM_WINDOW_HOURS=48
RETURN_VIDEO_STORAGE_DIR=
